{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Global administrator grant document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the global admin.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display label of the admin.",
          "minLength": 1,
          "maxLength": 80
        },
        "addedBy": {
          "type": "string",
          "description": "UID of the admin who granted this role.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["uid", "displayName", "addedBy", "createdAt", "updatedAt"]
    },
    "WhitelistEntry": {
      "title": "WhitelistEntry",
      "description": "Admin-managed allowlist entry granting workspace access to a verified email address.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Lowercase normalized email address allowed to access Cadence.",
          "minLength": 3,
          "maxLength": 254
        },
        "label": {
          "type": "string",
          "description": "Optional admin note or group label (e.g. Period 3, Team Lead).",
          "maxLength": 80
        },
        "active": {
          "type": "boolean",
          "description": "Whether access is currently active for this email."
        },
        "canCreateBoards": {
          "type": "boolean",
          "description": "Whether this user is permitted to create new Kanban boards."
        },
        "addedBy": {
          "type": "string",
          "description": "UID of the admin or user who created this whitelist entry.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "inviteCode": {
          "type": "string",
          "description": "Optional workspace access code ID redeemed to join the whitelist.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["email", "label", "active", "addedBy", "createdAt", "updatedAt"]
    },
    "AccessCode": {
      "title": "AccessCode",
      "description": "Admin-generated workspace join code that automatically adds redeemers to the access whitelist.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Uppercase/alphanumeric join code document ID.",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "label": {
          "type": "string",
          "description": "Admin label applied to users who join with this code (e.g. Period 3 Roster).",
          "maxLength": 80
        },
        "active": {
          "type": "boolean",
          "description": "Whether the code can currently be used to join the whitelist."
        },
        "canCreateBoards": {
          "type": "boolean",
          "description": "Default board creation permission assigned to users who join with this code."
        },
        "createdBy": {
          "type": "string",
          "description": "UID of the admin who generated this access code.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["id", "label", "active", "createdBy", "createdAt", "updatedAt"]
    },
    "EmailLookup": {
      "title": "EmailLookup",
      "description": "One-way SHA-256 hash mapping a normalized email address to a user UID without exposing plaintext PII.",
      "type": "object",
      "properties": {
        "emailHash": {
          "type": "string",
          "description": "64-character lowercase SHA-256 hex digest of lowercase email.",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Public display name for UI confirmation.",
          "minLength": 1,
          "maxLength": 80
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["emailHash", "uid", "displayName", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public-safe user workspace profile and UI preferences (no PII).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "photoUrl": {
          "type": "string",
          "description": "Optional avatar URL.",
          "maxLength": 500
        },
        "activeBoardId": {
          "type": "string",
          "description": "Last selected Kanban board ID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "theme": {
          "type": "string",
          "description": "Preferred UI color theme.",
          "enum": ["light", "dark"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["uid", "displayName", "theme", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record containing the user's email address.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "description": "Verified user email address.",
          "minLength": 3,
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "BoardRef": {
      "title": "BoardRef",
      "description": "User-scoped pointer to a shared Kanban board for efficient list queries.",
      "type": "object",
      "properties": {
        "boardId": {
          "type": "string",
          "description": "Shared Kanban board ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Collaborator UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "boardTitle": {
          "type": "string",
          "description": "Cached board title for sidebar listing.",
          "minLength": 1,
          "maxLength": 80
        },
        "boardOwnerId": {
          "type": "string",
          "description": "UID of the board creator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "description": "Assigned role key (built-in preset or custom).",
          "enum": ["viewer", "contributor", "editor", "manager", "custom"]
        },
        "customRoleName": {
          "type": "string",
          "description": "Optional board-defined custom role name when role is custom.",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["boardId", "userId", "boardTitle", "boardOwnerId", "role", "createdAt", "updatedAt"]
    },
    "Board": {
      "title": "Board",
      "description": "A Kanban board owned by a creator and shareable with collaborators.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Board document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the board creator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerDisplayName": {
          "type": "string",
          "description": "Optional display name of the board creator.",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "description": "Display title of the Kanban board.",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "description": "Short summary of the board purpose.",
          "maxLength": 300
        },
        "status": {
          "type": "string",
          "description": "Lifecycle status of the board.",
          "enum": ["active", "archived"]
        },
        "backgroundImageUrl": {
          "type": "string",
          "description": "Optional https/http image URL used as the background for this board only.",
          "maxLength": 500
        },
        "surfaceOpacityEnabled": {
          "type": "boolean",
          "description": "Whether column and task card backgrounds use custom translucency to reveal the board background image."
        },
        "surfaceOpacity": {
          "type": "number",
          "description": "Opacity percentage (0-100) applied to column and task card backgrounds when enabled."
        },
        "customRoles": {
          "type": "array",
          "description": "Up to 8 board-specific custom named roles with assigned utility permissions."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["id", "ownerId", "title", "description", "status", "createdAt", "updatedAt"]
    },
    "BoardMember": {
