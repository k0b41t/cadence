          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "taskId": {
          "type": "string",
          "description": "Attached task ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "taskTitle": {
          "type": "string",
          "description": "Task title label at send time.",
          "minLength": 1,
          "maxLength": 140
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the parent board creator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderId": {
          "type": "string",
          "description": "UID of the user who sent the message.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "description": "Display name of the sender.",
          "minLength": 1,
          "maxLength": 80
        },
        "text": {
          "type": "string",
          "description": "Chat message body.",
          "minLength": 1,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["id", "boardId", "taskId", "taskTitle", "ownerId", "senderId", "senderName", "text", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Global admin role registry."
    },
    "/whitelist/{emailKey}": {
      "schema": { "$ref": "#/entities/WhitelistEntry" },
      "description": "Admin-managed email access allowlist enforced on workspace initialization and writes."
    },
    "/accessCodes/{codeId}": {
      "schema": { "$ref": "#/entities/AccessCode" },
      "description": "Admin-generated workspace join codes redeemable to auto-add verified emails to /whitelist."
    },
    "/emailLookup/{emailHash}": {
      "schema": { "$ref": "#/entities/EmailLookup" },
      "description": "Hashed email lookup index for board sharing without storing plaintext emails."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public-safe user profile and preferences."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Private PII document (email) isolated to the owning user or admin."
    },
    "/users/{userId}/boardRefs/{boardId}": {
      "schema": { "$ref": "#/entities/BoardRef" },
      "description": "User-scoped pointers to boards shared with this user."
    },
    "/boards/{boardId}": {
      "schema": { "$ref": "#/entities/Board" },
      "description": "Top-level Kanban boards."
    },
    "/boards/{boardId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/BoardMember" },
      "description": "Board collaborators and their granular utility permissions."
    },
    "/boards/{boardId}/invites/{inviteId}": {
      "schema": { "$ref": "#/entities/BoardInvite" },
      "description": "Shareable invite passes with fixed permissions."
    },
    "/boards/{boardId}/columns/{columnId}": {
      "schema": { "$ref": "#/entities/Column" },
      "description": "Columns belonging to a Kanban board."
    },
    "/boards/{boardId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Task cards belonging to a Kanban board and column."
    },
    "/boards/{boardId}/tasks/{taskId}/subtasks/{subtaskId}": {
      "schema": { "$ref": "#/entities/Subtask" },
      "description": "Checklist subtasks belonging to a Kanban task."
    },
    "/boards/{boardId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/TaskMessage" },
      "description": "Task chat log messages belonging to a Kanban board and linked to a task."
    }
  }
}
