        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "uid",
        "boardId",
        "ownerId",
        "displayName",
        "role",
        "canView",
        "canCreateTasks",
        "canEditTasks",
        "canDeleteTasks",
        "canManageColumns",
        "createdAt",
        "updatedAt"
      ]
    },
