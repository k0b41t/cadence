          "description": "Preset role name or custom.",
          "enum": ["viewer", "contributor", "editor", "manager", "custom"]
        },
        "customRoleName": {
          "type": "string",
          "description": "Optional board-defined custom role name when role is custom.",
          "maxLength": 40
        },
        "canView": {
          "type": "boolean",
          "description": "Allows viewing the board, columns, and tasks."
        },
        "canCreateTasks": {
          "type": "boolean",
          "description": "Allows creating tasks and subtasks."
        },
        "canEditTasks": {
          "type": "boolean",
          "description": "Allows editing, completing, and moving tasks across columns."
