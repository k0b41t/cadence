rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Phase 3: Global Hardened Helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'btuttle@orangeusd.org';
    }

    function isAdmin() {
      return isBootstrapAdmin()
        || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidOptionalId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]*$');
    }

    function isValidEmailKey(emailKey) {
      return emailKey is string
        && emailKey.size() >= 3
        && emailKey.size() <= 254
        && emailKey == emailKey.lower()
        && emailKey.matches('^[^@\\s/]+@[^@\\s/]+\\.[^@\\s/]+$');
    }

    function isWhitelistedEmail() {
      return isVerifiedUser()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower())).data.active == true;
    }

    function isAllowedWorkspaceUser() {
      return isAdmin() || isWhitelistedEmail();
    }

    function canUserCreateBoards() {
      return isAdmin() || (
        isWhitelistedEmail()
        && 'canCreateBoards' in get(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower())).data
        && get(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower())).data.canCreateBoards == true
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function boardExists(boardId) {
      return exists(/databases/$(database)/documents/boards/$(boardId));
    }

    function getBoard(boardId) {
      return get(/databases/$(database)/documents/boards/$(boardId));
    }

    function isBoardOwner(boardId) {
      return boardExists(boardId) && getBoard(boardId).data.ownerId == request.auth.uid;
    }

    function isBoardActive(boardId) {
      return boardExists(boardId) && getBoard(boardId).data.status == 'active';
    }

    function memberExists(boardId, uid) {
      return exists(/databases/$(database)/documents/boards/$(boardId)/members/$(uid));
    }

    function getMember(boardId, uid) {
      return get(/databases/$(database)/documents/boards/$(boardId)/members/$(uid));
    }

    function isBoardMember(boardId) {
      return isSignedIn() && memberExists(boardId, request.auth.uid) && getMember(boardId, request.auth.uid).data.canView == true;
    }

    function canAccessBoard(boardId) {
      return isAdmin() || isBoardOwner(boardId) || isBoardMember(boardId);
    }

    function isValidAssignee(boardId, assigneeId) {
      return assigneeId == ''
        || assigneeId == getBoard(boardId).data.ownerId
        || memberExists(boardId, assigneeId)
        || exists(/databases/$(database)/documents/admins/$(assigneeId));
    }

    function canCreateTasksOnBoard(boardId) {
      return isAdmin()
        || isBoardOwner(boardId)
        || (memberExists(boardId, request.auth.uid) && getMember(boardId, request.auth.uid).data.canCreateTasks == true);
    }

    function canEditTasksOnBoard(boardId) {
      return isAdmin()
        || isBoardOwner(boardId)
        || (memberExists(boardId, request.auth.uid) && getMember(boardId, request.auth.uid).data.canEditTasks == true);
    }

    function canDeleteTasksOnBoard(boardId) {
      return isAdmin()
        || isBoardOwner(boardId)
        || (memberExists(boardId, request.auth.uid) && getMember(boardId, request.auth.uid).data.canDeleteTasks == true);
    }

    function canManageColumnsOnBoard(boardId) {
      return isAdmin()
        || isBoardOwner(boardId)
        || (memberExists(boardId, request.auth.uid) && getMember(boardId, request.auth.uid).data.canManageColumns == true);
    }

    function inviteMatchesMember(boardId, inviteId, data) {
      return isValidId(inviteId)
        && exists(/databases/$(database)/documents/boards/$(boardId)/invites/$(inviteId))
        && get(/databases/$(database)/documents/boards/$(boardId)/invites/$(inviteId)).data.active == true
        && data.role == get(/databases/$(database)/documents/boards/$(boardId)/invites/$(inviteId)).data.role
        && (
          (!('customRoleName' in data) && !('customRoleName' in get(/databases/$(database)/documents/boards/$(boardId)/invites/$(inviteId)).data)) ||
          ('customRoleName' in data && 'customRoleName' in get(/databases/$(database)/documents/boards/$(boardId)/invites/$(inviteId)).data && data.customRoleName == get(/databases/$(database)/documents/boards/$(boardId)/invites/$(inviteId)).data.customRoleName)
        )
        && data.canCreateTasks == get(/databases/$(database)/documents/boards/$(boardId)/invites/$(inviteId)).data.canCreateTasks
        && data.canEditTasks == get(/databases/$(database)/documents/boards/$(boardId)/invites/$(inviteId)).data.canEditTasks
        && data.canDeleteTasks == get(/databases/$(database)/documents/boards/$(boardId)/invites/$(inviteId)).data.canDeleteTasks
        && data.canManageColumns == get(/databases/$(database)/documents/boards/$(boardId)/invites/$(inviteId)).data.canManageColumns;
    }

    function pendingBoardMatchesMember(boardId, emailKey, data) {
      return isValidEmailKey(emailKey)
        && exists(/databases/$(database)/documents/whitelist/$(emailKey)/pendingBoards/$(boardId))
        && exists(/databases/$(database)/documents/boards/$(boardId)/pendingMembers/$(get(/databases/$(database)/documents/whitelist/$(emailKey)/pendingBoards/$(boardId)).data.emailHash))
        && data.ownerId == get(/databases/$(database)/documents/whitelist/$(emailKey)/pendingBoards/$(boardId)).data.ownerId
        && data.role == get(/databases/$(database)/documents/whitelist/$(emailKey)/pendingBoards/$(boardId)).data.role
        && (
          (!('customRoleName' in data) && !('customRoleName' in get(/databases/$(database)/documents/whitelist/$(emailKey)/pendingBoards/$(boardId)).data)) ||
          ('customRoleName' in data && 'customRoleName' in get(/databases/$(database)/documents/whitelist/$(emailKey)/pendingBoards/$(boardId)).data && data.customRoleName == get(/databases/$(database)/documents/whitelist/$(emailKey)/pendingBoards/$(boardId)).data.customRoleName)
        )
        && data.canCreateTasks == get(/databases/$(database)/documents/whitelist/$(emailKey)/pendingBoards/$(boardId)).data.canCreateTasks
        && data.canEditTasks == get(/databases/$(database)/documents/whitelist/$(emailKey)/pendingBoards/$(boardId)).data.canEditTasks
        && data.canDeleteTasks == get(/databases/$(database)/documents/whitelist/$(emailKey)/pendingBoards/$(boardId)).data.canDeleteTasks
        && data.canManageColumns == get(/databases/$(database)/documents/whitelist/$(emailKey)/pendingBoards/$(boardId)).data.canManageColumns;
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidAdminRecord(data, adminUid) {
      return data.uid is string && data.uid == adminUid && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.addedBy is string && isValidId(data.addedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWhitelistEntry(data, emailKey) {
      return data.email is string && data.email == emailKey && isValidEmailKey(data.email)
        && data.label is string && data.label.size() <= 80
        && data.active is bool
        && (!('canCreateBoards' in data) || data.canCreateBoards is bool)
        && data.addedBy is string && isValidId(data.addedBy)
        && (!('inviteCode' in data) || isValidOptionalId(data.inviteCode))
        && (!('boardInviteBoardId' in data) || isValidOptionalId(data.boardInviteBoardId))
        && (!('boardInviteId' in data) || isValidOptionalId(data.boardInviteId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPendingBoardGrant(data, emailKey, boardId) {
      return data.boardId is string && data.boardId == boardId && isValidId(data.boardId)
        && data.email is string && data.email == emailKey && isValidEmailKey(data.email)
        && data.emailHash is string && data.emailHash.size() == 64 && data.emailHash.matches('^[a-f0-9]{64}$')
        && data.boardTitle is string && data.boardTitle.size() >= 1 && data.boardTitle.size() <= 80
        && data.ownerId is string && isValidId(data.ownerId)
        && data.createdBy is string && isValidId(data.createdBy)
        && data.role in ['viewer', 'contributor', 'editor', 'manager', 'custom']
        && (!('customRoleName' in data) || (data.customRoleName is string && data.customRoleName.size() <= 40))
        && data.canCreateTasks is bool
        && data.canEditTasks is bool
        && data.canDeleteTasks is bool
        && data.canManageColumns is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPendingMemberNotice(data, boardId, emailHash) {
      return data.emailHash is string && data.emailHash == emailHash
        && data.emailHash.size() == 64 && data.emailHash.matches('^[a-f0-9]{64}$')
        && data.boardId is string && data.boardId == boardId && isValidId(data.boardId)
        && data.ownerId is string && isValidId(data.ownerId)
        && data.createdBy is string && isValidId(data.createdBy)
        && data.maskedEmail is string && data.maskedEmail.size() >= 3 && data.maskedEmail.size() <= 80
        && data.role in ['viewer', 'contributor', 'editor', 'manager', 'custom']
        && (!('customRoleName' in data) || (data.customRoleName is string && data.customRoleName.size() <= 40))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAccessCode(data, codeId) {
      return data.id is string && data.id == codeId && isValidId(data.id) && data.id.size() >= 4
        && data.label is string && data.label.size() <= 80
        && data.active is bool
        && (!('canCreateBoards' in data) || data.canCreateBoards is bool)
        && data.createdBy is string && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEmailLookup(data, emailHash) {
      return data.emailHash is string && data.emailHash == emailHash
        && data.emailHash.size() == 64 && data.emailHash.matches('^[a-f0-9]{64}$')
        && data.uid is string && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.updatedAt is timestamp;
    }

    function isValidUserBoardOrder(order) {
      return order is list
        && order.size() <= 200
        && (order.size() == 0 || (order[0] is string && isValidId(order[0])));
    }

    function isValidUserProfile(data, userId) {
      return data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.theme in ['light', 'dark']
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && (!('activeBoardId' in data) || isValidOptionalId(data.activeBoardId))
        && (!('boardOrder' in data) || isValidUserBoardOrder(data.boardOrder))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBoardRef(data, userId, boardId) {
      return data.boardId is string && data.boardId == boardId && isValidId(data.boardId)
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.boardTitle is string && data.boardTitle.size() >= 1 && data.boardTitle.size() <= 80
        && data.boardOwnerId is string && isValidId(data.boardOwnerId)
        && data.role in ['viewer', 'contributor', 'editor', 'manager', 'custom']
        && (!('customRoleName' in data) || (data.customRoleName is string && data.customRoleName.size() <= 40))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBoardBgUrl(url) {
      return url is string
        && url.size() <= 500
        && (url == '' || (url.size() >= 8 && url.matches('^https?://[^\\s]+$')));
    }

    function isValidBoardCustomRoleItem(item) {
      return item is map
        && item.keys().hasAll(['id', 'name', 'canCreateTasks', 'canEditTasks', 'canDeleteTasks', 'canManageColumns'])
        && item.keys().hasOnly(['id', 'name', 'canCreateTasks', 'canEditTasks', 'canDeleteTasks', 'canManageColumns'])
        && item.id is string && isValidId(item.id)
        && item.name is string && item.name.size() >= 1 && item.name.size() <= 40
        && item.canCreateTasks is bool
        && item.canEditTasks is bool
        && item.canDeleteTasks is bool
        && item.canManageColumns is bool;
    }

    function isValidBoardCustomRoles(roles) {
      return roles is list
        && roles.size() <= 8
        && (roles.size() == 0 || isValidBoardCustomRoleItem(roles[0]));
    }

    function isValidBoard(data, boardId) {
      return data.id is string && data.id == boardId && isValidId(data.id)
        && data.ownerId is string && isValidId(data.ownerId)
        && (!('ownerDisplayName' in data) || (data.ownerDisplayName is string && data.ownerDisplayName.size() >= 1 && data.ownerDisplayName.size() <= 80))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.description is string && data.description.size() <= 300
        && data.status in ['active', 'archived']
        && (!('backgroundImageUrl' in data) || isValidBoardBgUrl(data.backgroundImageUrl))
        && (!('surfaceOpacityEnabled' in data) || data.surfaceOpacityEnabled is bool)
        && (!('surfaceOpacity' in data) || (data.surfaceOpacity is number && data.surfaceOpacity >= 0 && data.surfaceOpacity <= 100))
        && (!('customRoles' in data) || isValidBoardCustomRoles(data.customRoles))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBoardMember(data, boardId, memberId) {
      return data.uid is string && data.uid == memberId && isValidId(data.uid)
        && data.boardId is string && data.boardId == boardId && isValidId(data.boardId)
        && data.ownerId is string && isValidId(data.ownerId)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.role in ['viewer', 'contributor', 'editor', 'manager', 'custom']
        && (!('customRoleName' in data) || (data.customRoleName is string && data.customRoleName.size() <= 40))
        && data.canView is bool
        && data.canCreateTasks is bool
        && data.canEditTasks is bool
        && data.canDeleteTasks is bool
        && data.canManageColumns is bool
        && (!('inviteId' in data) || isValidOptionalId(data.inviteId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBoardInvite(data, boardId, inviteId) {
      return data.id is string && data.id == inviteId && isValidId(data.id)
        && data.boardId is string && data.boardId == boardId && isValidId(data.boardId)
        && (!('boardTitle' in data) || (data.boardTitle is string && data.boardTitle.size() >= 1 && data.boardTitle.size() <= 80))
        && (!('joinCode' in data) || (isValidId(data.joinCode) && data.joinCode.size() >= 4))
        && data.ownerId is string && isValidId(data.ownerId)
        && data.createdBy is string && isValidId(data.createdBy)
        && data.label is string && data.label.size() <= 60
        && data.role in ['viewer', 'contributor', 'editor', 'manager', 'custom']
        && (!('customRoleName' in data) || (data.customRoleName is string && data.customRoleName.size() <= 40))
        && data.canCreateTasks is bool
        && data.canEditTasks is bool
        && data.canDeleteTasks is bool
        && data.canManageColumns is bool
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBoardCode(data, codeId) {
      return data.id is string && data.id == codeId && isValidId(data.id) && data.id.size() >= 4
        && data.boardId is string && isValidId(data.boardId)
        && data.inviteId is string && isValidId(data.inviteId)
        && data.ownerId is string && isValidId(data.ownerId)
        && data.createdBy is string && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidColumnColorValue(color) {
      return color in ['slate', 'amber', 'red', 'emerald', 'blue', 'violet']
        || (color is string && color.size() == 7 && color.matches('^#[0-9a-fA-F]{6}$'));
    }

    function isValidColumnColorRule(item) {
      return item is map
        && item.keys().hasAll(['threshold', 'color'])
        && item.keys().hasOnly(['threshold', 'color'])
        && item.threshold is number && item.threshold >= 1 && item.threshold <= 100
        && isValidColumnColorValue(item.color);
    }

    function isValidColumnColorRules(rules) {
      return rules is list
        && rules.size() <= 6
        && (rules.size() == 0 || isValidColumnColorRule(rules[0]));
    }

    function isValidColumn(data, boardId, columnId) {
      return data.id is string && data.id == columnId && isValidId(data.id)
        && data.boardId is string && data.boardId == boardId && isValidId(data.boardId)
        && data.ownerId is string && isValidId(data.ownerId)
        && (!('createdBy' in data) || isValidId(data.createdBy))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 50
        && data.position is number && data.position >= 0 && data.position <= 1000000
        && data.wipLimit is number && data.wipLimit >= 0 && data.wipLimit <= 100
        && (!('colorRules' in data) || isValidColumnColorRules(data.colorRules))
        && (!('autoMoveOnComplete' in data) || data.autoMoveOnComplete is bool)
        && (!('autoMoveTargetColumnId' in data) || isValidOptionalId(data.autoMoveTargetColumnId))
        && (!('requireReviewBeforeMove' in data) || data.requireReviewBeforeMove is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTags(tags) {
      return tags is list
        && tags.size() <= 5
        && (tags.size() == 0 || (tags[0] is string && tags[0].size() >= 1 && tags[0].size() <= 24));
    }

    function isValidDateString(val) {
      return val is string && val.size() <= 32 && val.matches('^(\\d{4}-\\d{2}-\\d{2})?$');
    }

    function isValidTaskLinkItem(item) {
      return item is map
        && item.keys().hasAll(['label', 'url', 'kind'])
        && item.keys().hasOnly(['label', 'url', 'kind'])
        && item.label is string && item.label.size() >= 1 && item.label.size() <= 60
        && item.url is string && item.url.size() >= 8 && item.url.size() <= 500
        && item.url.matches('^https?://[^\\s]+$')
        && item.kind in ['repo', 'file', 'doc', 'other'];
    }

    function isValidTaskLinks(links) {
      return links is list
        && links.size() <= 8
        && (links.size() == 0 || isValidTaskLinkItem(links[0]));
    }

    function isValidTaskMilestoneItem(item) {
      return item is map
        && item.keys().hasAll(['id', 'title', 'date'])
        && item.keys().hasOnly(['id', 'title', 'date'])
        && item.id is string && isValidId(item.id)
        && item.title is string && item.title.size() >= 1 && item.title.size() <= 60
        && item.date is string && item.date.size() == 10 && item.date.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidTaskMilestones(milestones) {
      return milestones is list
        && milestones.size() <= 8
        && (milestones.size() == 0 || isValidTaskMilestoneItem(milestones[0]));
    }

    function isValidTask(data, boardId, taskId) {
      return data.id is string && data.id == taskId && isValidId(data.id)
        && data.boardId is string && data.boardId == boardId && isValidId(data.boardId)
        && data.columnId is string && isValidId(data.columnId)
        && data.ownerId is string && isValidId(data.ownerId)
        && (!('createdBy' in data) || isValidId(data.createdBy))
        && (!('assigneeId' in data) || isValidOptionalId(data.assigneeId))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.description is string && data.description.size() <= 2000
        && data.priority in ['low', 'medium', 'high', 'urgent']
        && data.position is number && data.position >= 0 && data.position <= 1000000
        && isValidTags(data.tags)
        && isValidDateString(data.dueDate)
        && data.completed is bool
        && (!('placedOnColumnAt' in data) || isValidDateString(data.placedOnColumnAt))
        && (!('completedAt' in data) || isValidDateString(data.completedAt))
        && (!('links' in data) || isValidTaskLinks(data.links))
        && (!('milestones' in data) || isValidTaskMilestones(data.milestones))
        && (!('notificationsEnabled' in data) || data.notificationsEnabled is bool)
        && (!('reviewerId' in data) || isValidOptionalId(data.reviewerId))
        && (!('reviewed' in data) || data.reviewed is bool)
        && (!('reviewedAt' in data) || isValidDateString(data.reviewedAt))
        && (!('reviewedBy' in data) || isValidOptionalId(data.reviewedBy))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubtask(data, boardId, taskId, subtaskId) {
      return data.id is string && data.id == subtaskId && isValidId(data.id)
        && data.boardId is string && data.boardId == boardId && isValidId(data.boardId)
        && data.taskId is string && data.taskId == taskId && isValidId(data.taskId)
        && data.ownerId is string && isValidId(data.ownerId)
        && (!('createdBy' in data) || isValidId(data.createdBy))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.completed is bool
        && data.position is number && data.position >= 0 && data.position <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTaskMessage(data, boardId, messageId) {
      return data.id is string && data.id == messageId && isValidId(data.id)
        && data.boardId is string && data.boardId == boardId && isValidId(data.boardId)
        && data.taskId is string && isValidId(data.taskId)
        && data.taskTitle is string && data.taskTitle.size() >= 1 && data.taskTitle.size() <= 140
        && data.ownerId is string && isValidId(data.ownerId)
        && data.senderId is string && isValidId(data.senderId)
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Global Admins Registry
    // -------------------------------------------------------------------------
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isSignedIn() && isBootstrapAdmin();

      allow create: if isAdmin()
        && isValidId(adminUid)
        && incoming().keys().hasAll(['uid', 'displayName', 'addedBy', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['uid', 'displayName', 'addedBy', 'createdAt', 'updatedAt'])
        && isValidAdminRecord(incoming(), adminUid)
        && incoming().addedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if false;
      allow delete: if isAdmin() && isValidId(adminUid) && adminUid != request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Admin-Generated Workspace Access Codes (No Non-Admin List)
    // -------------------------------------------------------------------------
    match /accessCodes/{codeId} {
      allow get: if isSignedIn() && isValidId(codeId) && codeId.size() >= 4;
      allow list: if isSignedIn() && isAdmin();

      allow create: if isAdmin()
        && isValidId(codeId) && codeId.size() >= 4
        && incoming().keys().hasAll(['id', 'label', 'active', 'createdBy', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['id', 'label', 'active', 'canCreateBoards', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidAccessCode(incoming(), codeId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(codeId) && codeId.size() >= 4
        && isValidAccessCode(incoming(), codeId)
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['active', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['canCreateBoards', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['label', 'active', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['label', 'active', 'canCreateBoards', 'updatedAt'])
        );

      allow delete: if isAdmin() && isValidId(codeId);
    }

    // -------------------------------------------------------------------------
    // Short Board Join Codes (Direct Get Only, Zero Enumeration)
    // -------------------------------------------------------------------------
    match /boardCodes/{codeId} {
      allow get: if isSignedIn() && isValidId(codeId) && codeId.size() >= 4;
      allow list: if false;

      allow create: if isAllowedWorkspaceUser()
        && isValidId(codeId) && codeId.size() >= 4
        && incoming().keys().hasAll(['id', 'boardId', 'inviteId', 'ownerId', 'createdBy', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['id', 'boardId', 'inviteId', 'ownerId', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidBoardCode(incoming(), codeId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && boardExists(incoming().boardId)
        && incoming().ownerId == getBoard(incoming().boardId).data.ownerId
        && (isAdmin() || (isBoardOwner(incoming().boardId) && isBoardActive(incoming().boardId)));

      allow update: if false;

      allow delete: if isAllowedWorkspaceUser()
        && isValidId(codeId)
        && (isAdmin() || isBoardOwner(existing().boardId));
    }

    // -------------------------------------------------------------------------
    // Admin-Managed Access Whitelist (Zero-Trust Gate + PII Isolation)
    // -------------------------------------------------------------------------
    match /whitelist/{emailKey} {
      allow get: if isSignedIn() && isValidEmailKey(emailKey) && (
        isAdmin() ||
        canUserCreateBoards() ||
        (isVerifiedUser() && request.auth.token.email is string && request.auth.token.email.lower() == emailKey)
      );
      allow list: if isSignedIn() && isAdmin();

      allow create: if isValidEmailKey(emailKey)
        && isValidWhitelistEntry(incoming(), emailKey)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            isAdmin()
            && incoming().keys().hasAll(['email', 'label', 'active', 'addedBy', 'createdAt', 'updatedAt'])
            && incoming().keys().hasOnly(['email', 'label', 'active', 'canCreateBoards', 'addedBy', 'inviteCode', 'boardInviteBoardId', 'boardInviteId', 'createdAt', 'updatedAt'])
            && incoming().addedBy == request.auth.uid
          ) || (
            canUserCreateBoards()
            && incoming().keys().hasAll(['email', 'label', 'active', 'canCreateBoards', 'addedBy', 'createdAt', 'updatedAt'])
            && incoming().keys().hasOnly(['email', 'label', 'active', 'canCreateBoards', 'addedBy', 'createdAt', 'updatedAt'])
            && incoming().active == true
            && incoming().canCreateBoards == false
            && incoming().addedBy == request.auth.uid
          ) || (
            isVerifiedUser()
            && request.auth.token.email is string
            && request.auth.token.email.lower() == emailKey
            && incoming().keys().hasAll(['email', 'label', 'active', 'canCreateBoards', 'addedBy', 'inviteCode', 'createdAt', 'updatedAt'])
            && incoming().keys().hasOnly(['email', 'label', 'active', 'canCreateBoards', 'addedBy', 'inviteCode', 'createdAt', 'updatedAt'])
            && incoming().active == true
            && incoming().addedBy == request.auth.uid
            && isValidId(incoming().inviteCode)
            && incoming().inviteCode.size() >= 4
            && exists(/databases/$(database)/documents/accessCodes/$(incoming().inviteCode))
            && get(/databases/$(database)/documents/accessCodes/$(incoming().inviteCode)).data.active == true
            && incoming().label == get(/databases/$(database)/documents/accessCodes/$(incoming().inviteCode)).data.label
            && incoming().canCreateBoards == (('canCreateBoards' in get(/databases/$(database)/documents/accessCodes/$(incoming().inviteCode)).data) && get(/databases/$(database)/documents/accessCodes/$(incoming().inviteCode)).data.canCreateBoards == true)
          ) || (
            isVerifiedUser()
            && request.auth.token.email is string
            && request.auth.token.email.lower() == emailKey
            && incoming().keys().hasAll(['email', 'label', 'active', 'canCreateBoards', 'addedBy', 'boardInviteBoardId', 'boardInviteId', 'createdAt', 'updatedAt'])
            && incoming().keys().hasOnly(['email', 'label', 'active', 'canCreateBoards', 'addedBy', 'boardInviteBoardId', 'boardInviteId', 'createdAt', 'updatedAt'])
            && incoming().active == true
            && incoming().canCreateBoards == false
            && incoming().addedBy == request.auth.uid
            && isValidId(incoming().boardInviteBoardId)
            && isValidId(incoming().boardInviteId)
            && exists(/databases/$(database)/documents/boards/$(incoming().boardInviteBoardId)/invites/$(incoming().boardInviteId))
            && get(/databases/$(database)/documents/boards/$(incoming().boardInviteBoardId)/invites/$(incoming().boardInviteId)).data.active == true
            && exists(/databases/$(database)/documents/boards/$(incoming().boardInviteBoardId))
            && get(/databases/$(database)/documents/boards/$(incoming().boardInviteBoardId)).data.status == 'active'
          )
        );

      allow update: if isAdmin()
        && isValidEmailKey(emailKey)
        && isValidWhitelistEntry(incoming(), emailKey)
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['active', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['canCreateBoards', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['label', 'active', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['label', 'active', 'canCreateBoards', 'updatedAt'])
        );

      allow delete: if isAdmin() && isValidEmailKey(emailKey);

      match /pendingBoards/{boardId} {
        allow get: if isSignedIn() && isValidEmailKey(emailKey) && isValidId(boardId) && (
          isAdmin() ||
          isBoardOwner(boardId) ||
          (isVerifiedUser() && request.auth.token.email is string && request.auth.token.email.lower() == emailKey)
        );
        allow list: if isSignedIn() && isValidEmailKey(emailKey) && (
          isAdmin() ||
          (isVerifiedUser() && request.auth.token.email is string && request.auth.token.email.lower() == emailKey)
        );

        allow create: if isAllowedWorkspaceUser()
          && isValidEmailKey(emailKey)
          && isValidId(boardId)
          && incoming().keys().hasAll(['boardId', 'email', 'emailHash', 'boardTitle', 'ownerId', 'createdBy', 'role', 'canCreateTasks', 'canEditTasks', 'canDeleteTasks', 'canManageColumns', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['boardId', 'email', 'emailHash', 'boardTitle', 'ownerId', 'createdBy', 'role', 'customRoleName', 'canCreateTasks', 'canEditTasks', 'canDeleteTasks', 'canManageColumns', 'createdAt', 'updatedAt'])
          && isValidPendingBoardGrant(incoming(), emailKey, boardId)
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && boardExists(boardId)
          && incoming().ownerId == getBoard(boardId).data.ownerId
          && (isAdmin() || (isBoardOwner(boardId) && isBoardActive(boardId)));

        allow update: if isAllowedWorkspaceUser()
          && isValidEmailKey(emailKey)
          && isValidId(boardId)
          && isValidPendingBoardGrant(incoming(), emailKey, boardId)
          && incoming().boardId == existing().boardId
          && incoming().email == existing().email
          && incoming().emailHash == existing().emailHash
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (isAdmin() || (isBoardOwner(boardId) && isBoardActive(boardId)))
          && incoming().diff(existing()).affectedKeys().hasOnly(['boardTitle', 'role', 'customRoleName', 'canCreateTasks', 'canEditTasks', 'canDeleteTasks', 'canManageColumns', 'updatedAt']);

        allow delete: if isSignedIn()
          && isValidEmailKey(emailKey)
          && isValidId(boardId)
          && (
            isAdmin() ||
            isBoardOwner(boardId) ||
            (isVerifiedUser() && request.auth.token.email is string && request.auth.token.email.lower() == emailKey)
          );
      }
    }

    // -------------------------------------------------------------------------
    // Hashed Email Lookup (Zero Plaintext PII, No List)
    // -------------------------------------------------------------------------
    match /emailLookup/{emailHash} {
      allow get: if isSignedIn() && emailHash.size() == 64 && emailHash.matches('^[a-f0-9]{64}$');
      allow list: if false;

      allow create: if isAllowedWorkspaceUser()
        && emailHash.size() == 64 && emailHash.matches('^[a-f0-9]{64}$')
        && incoming().keys().hasAll(['emailHash', 'uid', 'displayName', 'updatedAt'])
        && incoming().keys().hasOnly(['emailHash', 'uid', 'displayName', 'updatedAt'])
        && isValidEmailLookup(incoming(), emailHash)
        && incoming().uid == request.auth.uid
        && incoming().updatedAt == request.time;

      allow update: if isAllowedWorkspaceUser()
        && emailHash.size() == 64 && emailHash.matches('^[a-f0-9]{64}$')
        && existing().uid == request.auth.uid
        && isValidEmailLookup(incoming(), emailHash)
        && incoming().uid == existing().uid
        && incoming().emailHash == existing().emailHash
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);

      allow delete: if isVerifiedUser() && existing().uid == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Users, Private PII Split Collection, and Shared BoardRefs
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;

      allow create: if isAllowedWorkspaceUser()
        && isValidId(userId)
        && isOwner(userId)
        && incoming().keys().hasAll(['uid', 'displayName', 'theme', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['uid', 'displayName', 'photoUrl', 'activeBoardId', 'boardOrder', 'theme', 'createdAt', 'updatedAt'])
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAllowedWorkspaceUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['activeBoardId', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['boardOrder', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['theme', 'updatedAt'])
        );

      allow delete: if isVerifiedUser() && isValidId(userId) && isOwner(userId);

      match /private/{docId} {
        allow get: if isSignedIn() && isValidId(userId) && docId == 'info' && (isOwner(userId) || isAdmin());
        allow list: if false;

        allow create: if isAllowedWorkspaceUser()
          && isValidId(userId)
          && docId == 'info'
          && isOwner(userId)
          && incoming().keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt'])
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isAllowedWorkspaceUser()
          && isValidId(userId)
          && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);

        allow delete: if isVerifiedUser() && isValidId(userId) && docId == 'info' && isOwner(userId);
      }

      match /boardRefs/{boardId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(boardId)
          && (isOwner(userId) || isAdmin() || isBoardOwner(boardId));
        allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

        allow create: if isAllowedWorkspaceUser()
          && isValidId(userId)
          && isValidId(boardId)
          && incoming().keys().hasAll(['boardId', 'userId', 'boardTitle', 'boardOwnerId', 'role', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['boardId', 'userId', 'boardTitle', 'boardOwnerId', 'role', 'customRoleName', 'createdAt', 'updatedAt'])
          && isValidBoardRef(incoming(), userId, boardId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && boardExists(boardId)
          && incoming().boardOwnerId == getBoard(boardId).data.ownerId
          && (
            isAdmin() ||
            isBoardOwner(boardId) ||
            (
              isOwner(userId)
              && existsAfter(/databases/$(database)/documents/boards/$(boardId)/members/$(userId))
            )
          );

        allow update: if isAllowedWorkspaceUser()
          && isValidId(userId)
          && isValidId(boardId)
          && isValidBoardRef(incoming(), userId, boardId)
          && incoming().boardId == existing().boardId
          && incoming().userId == existing().userId
          && incoming().boardOwnerId == existing().boardOwnerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (isAdmin() || isBoardOwner(boardId))
          && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'customRoleName', 'boardTitle', 'updatedAt']);

        allow delete: if isAllowedWorkspaceUser()
          && isValidId(userId)
          && isValidId(boardId)
          && (isOwner(userId) || isAdmin() || isBoardOwner(boardId));
      }
    }

    // -------------------------------------------------------------------------
    // Boards (Master Resource)
    // -------------------------------------------------------------------------
    match /boards/{boardId} {
      allow get: if isSignedIn() && isValidId(boardId) && (
        isAdmin() ||
        existing().ownerId == request.auth.uid ||
        isBoardMember(boardId)
      );

      allow list: if isSignedIn() && (
        isBootstrapAdmin() ||
        resource.data.ownerId == request.auth.uid
      );

      allow create: if canUserCreateBoards()
        && isValidId(boardId)
        && incoming().keys().hasAll(['id', 'ownerId', 'title', 'description', 'status', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['id', 'ownerId', 'ownerDisplayName', 'title', 'description', 'status', 'backgroundImageUrl', 'surfaceOpacityEnabled', 'surfaceOpacity', 'customRoles', 'createdAt', 'updatedAt'])
        && isValidBoard(incoming(), boardId)
        && incoming().ownerId == request.auth.uid
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAllowedWorkspaceUser()
        && isValidId(boardId)
        && isValidBoard(incoming(), boardId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().status != 'archived'
            && existing().ownerId == request.auth.uid
            && (
              (incoming().status == 'archived' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
              (incoming().status == existing().status && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'backgroundImageUrl', 'surfaceOpacityEnabled', 'surfaceOpacity', 'updatedAt'])) ||
              (incoming().status == existing().status && incoming().diff(existing()).affectedKeys().hasOnly(['customRoles', 'updatedAt'])) ||
              (incoming().status == existing().status && incoming().diff(existing()).affectedKeys().hasOnly(['ownerDisplayName', 'updatedAt']))
            )
          )
        );

      allow delete: if isAllowedWorkspaceUser() && isValidId(boardId) && (isAdmin() || existing().ownerId == request.auth.uid);

      // -----------------------------------------------------------------------
      // Board Members Subcollection
      // -----------------------------------------------------------------------
      match /members/{memberId} {
        allow get: if isSignedIn() && isValidId(boardId) && isValidId(memberId) && canAccessBoard(boardId);
        allow list: if isSignedIn() && (
          isBootstrapAdmin() ||
          resource.data.ownerId == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          canAccessBoard(boardId)
        );

        allow create: if isAllowedWorkspaceUser()
          && isValidId(boardId)
          && isValidId(memberId)
          && incoming().keys().hasAll(['uid', 'boardId', 'ownerId', 'displayName', 'role', 'canView', 'canCreateTasks', 'canEditTasks', 'canDeleteTasks', 'canManageColumns', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['uid', 'boardId', 'ownerId', 'displayName', 'role', 'customRoleName', 'canView', 'canCreateTasks', 'canEditTasks', 'canDeleteTasks', 'canManageColumns', 'inviteId', 'createdAt', 'updatedAt'])
          && isValidBoardMember(incoming(), boardId, memberId)
          && incoming().canView == true
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && boardExists(boardId)
          && incoming().ownerId == getBoard(boardId).data.ownerId
          && (
            isAdmin() ||
            (isBoardOwner(boardId) && isBoardActive(boardId)) ||
            (
              isBoardActive(boardId)
              && isOwner(memberId)
              && 'inviteId' in incoming()
              && inviteMatchesMember(boardId, incoming().inviteId, incoming())
            ) ||
            (
              isBoardActive(boardId)
              && isOwner(memberId)
              && isVerifiedUser()
              && request.auth.token.email is string
              && pendingBoardMatchesMember(boardId, request.auth.token.email.lower(), incoming())
            )
          );

        allow update: if isAllowedWorkspaceUser()
          && isValidId(boardId)
          && isValidId(memberId)
          && isValidBoardMember(incoming(), boardId, memberId)
          && incoming().uid == existing().uid
          && incoming().boardId == existing().boardId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (isAdmin() || (isBoardOwner(boardId) && isBoardActive(boardId)))
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'role',
            'customRoleName',
            'canView',
            'canCreateTasks',
            'canEditTasks',
            'canDeleteTasks',
            'canManageColumns',
            'updatedAt'
          ]);

        allow delete: if isAllowedWorkspaceUser()
          && isValidId(boardId)
          && isValidId(memberId)
          && (isAdmin() || isBoardOwner(boardId) || isOwner(memberId));
      }

      // -----------------------------------------------------------------------
      // Pending Board Member Notices (No Plaintext PII)
      // -----------------------------------------------------------------------
      match /pendingMembers/{emailHash} {
        allow get: if isSignedIn() && isValidId(boardId)
          && emailHash.size() == 64 && emailHash.matches('^[a-f0-9]{64}$')
          && (isAdmin() || isBoardOwner(boardId));
        allow list: if isSignedIn() && (
          isBootstrapAdmin() ||
          resource.data.ownerId == request.auth.uid
        );

        allow create: if isAllowedWorkspaceUser()
          && isValidId(boardId)
          && emailHash.size() == 64 && emailHash.matches('^[a-f0-9]{64}$')
          && incoming().keys().hasAll(['emailHash', 'boardId', 'ownerId', 'createdBy', 'maskedEmail', 'role', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['emailHash', 'boardId', 'ownerId', 'createdBy', 'maskedEmail', 'role', 'customRoleName', 'createdAt', 'updatedAt'])
          && isValidPendingMemberNotice(incoming(), boardId, emailHash)
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && boardExists(boardId)
          && incoming().ownerId == getBoard(boardId).data.ownerId
          && (isAdmin() || (isBoardOwner(boardId) && isBoardActive(boardId)));

        allow update: if isAllowedWorkspaceUser()
          && isValidId(boardId)
          && emailHash.size() == 64 && emailHash.matches('^[a-f0-9]{64}$')
          && isValidPendingMemberNotice(incoming(), boardId, emailHash)
          && incoming().emailHash == existing().emailHash
          && incoming().boardId == existing().boardId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (isAdmin() || (isBoardOwner(boardId) && isBoardActive(boardId)))
          && incoming().diff(existing()).affectedKeys().hasOnly(['maskedEmail', 'role', 'customRoleName', 'updatedAt']);

        allow delete: if isAllowedWorkspaceUser()
          && isValidId(boardId)
          && emailHash.size() == 64 && emailHash.matches('^[a-f0-9]{64}$')
          && (isAdmin() || isBoardOwner(boardId) || isBoardMember(boardId));
      }

      // -----------------------------------------------------------------------
      // Board Invites Subcollection
      // -----------------------------------------------------------------------
      match /invites/{inviteId} {
        allow get: if isSignedIn() && isValidId(boardId) && isValidId(inviteId);
        allow list: if isSignedIn() && (isBootstrapAdmin() || resource.data.ownerId == request.auth.uid);

        allow create: if isAllowedWorkspaceUser()
          && isValidId(boardId)
          && isValidId(inviteId)
          && incoming().keys().hasAll(['id', 'boardId', 'ownerId', 'createdBy', 'label', 'role', 'canCreateTasks', 'canEditTasks', 'canDeleteTasks', 'canManageColumns', 'active', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['id', 'boardId', 'boardTitle', 'joinCode', 'ownerId', 'createdBy', 'label', 'role', 'customRoleName', 'canCreateTasks', 'canEditTasks', 'canDeleteTasks', 'canManageColumns', 'active', 'createdAt', 'updatedAt'])
          && isValidBoardInvite(incoming(), boardId, inviteId)
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && boardExists(boardId)
          && incoming().ownerId == getBoard(boardId).data.ownerId
          && (isAdmin() || (isBoardOwner(boardId) && isBoardActive(boardId)));

        allow update: if isAllowedWorkspaceUser()
          && isValidId(boardId)
          && isValidId(inviteId)
          && isValidBoardInvite(incoming(), boardId, inviteId)
          && incoming().id == existing().id
          && incoming().boardId == existing().boardId
          && incoming().ownerId == existing().ownerId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (isAdmin() || (isBoardOwner(boardId) && isBoardActive(boardId)))
          && incoming().diff(existing()).affectedKeys().hasOnly(['active', 'updatedAt']);

        allow delete: if isAllowedWorkspaceUser()
          && isValidId(boardId)
          && isValidId(inviteId)
          && (isAdmin() || isBoardOwner(boardId));
      }

      // -----------------------------------------------------------------------
      // Columns Subcollection
      // -----------------------------------------------------------------------
      match /columns/{columnId} {
        allow get: if isSignedIn() && isValidId(boardId) && isValidId(columnId) && canAccessBoard(boardId);
        allow list: if isSignedIn() && (
          isBootstrapAdmin() ||
          resource.data.ownerId == request.auth.uid ||
          canAccessBoard(boardId)
        );

        allow create: if isAllowedWorkspaceUser()
          && isValidId(boardId)
          && isValidId(columnId)
          && incoming().keys().hasAll(['id', 'boardId', 'ownerId', 'createdBy', 'title', 'position', 'wipLimit', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['id', 'boardId', 'ownerId', 'createdBy', 'title', 'position', 'wipLimit', 'colorRules', 'autoMoveOnComplete', 'autoMoveTargetColumnId', 'requireReviewBeforeMove', 'createdAt', 'updatedAt'])
          && isValidColumn(incoming(), boardId, columnId)
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && boardExists(boardId)
          && incoming().ownerId == getBoard(boardId).data.ownerId
          && (isAdmin() || (isBoardActive(boardId) && canManageColumnsOnBoard(boardId)));

        allow update: if isAllowedWorkspaceUser()
          && isValidId(boardId)
          && isValidId(columnId)
          && isValidColumn(incoming(), boardId, columnId)
          && incoming().id == existing().id
          && incoming().boardId == existing().boardId
          && incoming().ownerId == existing().ownerId
          && (!('createdBy' in existing()) || incoming().createdBy == existing().createdBy)
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (isAdmin() || (isBoardActive(boardId) && canManageColumnsOnBoard(boardId)))
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'wipLimit', 'colorRules', 'autoMoveOnComplete', 'autoMoveTargetColumnId', 'requireReviewBeforeMove', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'wipLimit', 'colorRules', 'autoMoveOnComplete', 'autoMoveTargetColumnId', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'wipLimit', 'colorRules', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'wipLimit', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['position', 'updatedAt'])
          );

        allow delete: if isAllowedWorkspaceUser()
          && isValidId(boardId)
          && isValidId(columnId)
          && (isAdmin() || (isBoardActive(boardId) && canManageColumnsOnBoard(boardId)));
      }

      // -----------------------------------------------------------------------
      // Tasks Subcollection
      // -----------------------------------------------------------------------
      match /tasks/{taskId} {
        allow get: if isSignedIn() && isValidId(boardId) && isValidId(taskId) && canAccessBoard(boardId);
        allow list: if isSignedIn() && (
          isBootstrapAdmin() ||
          resource.data.ownerId == request.auth.uid ||
          canAccessBoard(boardId)
        );

        allow create: if isAllowedWorkspaceUser()
          && isValidId(boardId)
          && isValidId(taskId)
          && incoming().keys().hasAll(['id', 'boardId', 'columnId', 'ownerId', 'createdBy', 'assigneeId', 'title', 'description', 'priority', 'position', 'tags', 'dueDate', 'completed', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['id', 'boardId', 'columnId', 'ownerId', 'createdBy', 'assigneeId', 'title', 'description', 'priority', 'position', 'tags', 'dueDate', 'completed', 'placedOnColumnAt', 'completedAt', 'links', 'milestones', 'notificationsEnabled', 'reviewerId', 'reviewed', 'reviewedAt', 'reviewedBy', 'createdAt', 'updatedAt'])
          && isValidTask(incoming(), boardId, taskId)
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && boardExists(boardId)
          && incoming().ownerId == getBoard(boardId).data.ownerId
          && exists(/databases/$(database)/documents/boards/$(boardId)/columns/$(incoming().columnId))
          && isValidAssignee(boardId, incoming().assigneeId)
          && (!('reviewerId' in incoming()) || isValidAssignee(boardId, incoming().reviewerId))
          && (isAdmin() || (isBoardActive(boardId) && canCreateTasksOnBoard(boardId)));

        allow update: if isAllowedWorkspaceUser()
          && isValidId(boardId)
          && isValidId(taskId)
          && isValidTask(incoming(), boardId, taskId)
          && incoming().id == existing().id
          && incoming().boardId == existing().boardId
          && incoming().ownerId == existing().ownerId
          && (!('createdBy' in existing()) || incoming().createdBy == existing().createdBy)
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/boards/$(boardId)/columns/$(incoming().columnId))
          && (
            !('assigneeId' in incoming())
            || incoming().assigneeId == ''
            || (('assigneeId' in existing()) && incoming().assigneeId == existing().assigneeId)
            || isValidAssignee(boardId, incoming().assigneeId)
          )
          && (
            !('reviewerId' in incoming())
            || incoming().reviewerId == ''
            || (('reviewerId' in existing()) && incoming().reviewerId == existing().reviewerId)
            || isValidAssignee(boardId, incoming().reviewerId)
          )
          && (
            !('reviewedBy' in incoming())
            || incoming().reviewedBy == ''
            || (('reviewedBy' in existing()) && incoming().reviewedBy == existing().reviewedBy)
            || incoming().reviewedBy == request.auth.uid
          )
          && (isAdmin() || (isBoardActive(boardId) && canEditTasksOnBoard(boardId)))
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['columnId', 'position', 'placedOnColumnAt', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['columnId', 'position', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'priority', 'tags', 'dueDate', 'completed', 'completedAt', 'placedOnColumnAt', 'assigneeId', 'links', 'milestones', 'notificationsEnabled', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'priority', 'tags', 'dueDate', 'completed', 'completedAt', 'placedOnColumnAt', 'assigneeId', 'links', 'milestones', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'priority', 'tags', 'dueDate', 'completed', 'assigneeId', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'priority', 'tags', 'dueDate', 'completed', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'completedAt', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['notificationsEnabled', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['reviewerId', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['reviewed', 'reviewedAt', 'reviewedBy', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['reviewerId', 'reviewed', 'reviewedAt', 'reviewedBy', 'updatedAt'])
          );

        allow delete: if isAllowedWorkspaceUser()
          && isValidId(boardId)
          && isValidId(taskId)
          && (isAdmin() || (isBoardActive(boardId) && canDeleteTasksOnBoard(boardId)));

        // ---------------------------------------------------------------------
        // Subtasks Subcollection
        // ---------------------------------------------------------------------
        match /subtasks/{subtaskId} {
          allow get: if isSignedIn() && isValidId(boardId) && isValidId(taskId) && isValidId(subtaskId) && canAccessBoard(boardId);
          allow list: if isSignedIn() && (
            isBootstrapAdmin() ||
            resource.data.ownerId == request.auth.uid ||
            canAccessBoard(boardId)
          );

          allow create: if isAllowedWorkspaceUser()
            && isValidId(boardId)
            && isValidId(taskId)
            && isValidId(subtaskId)
            && incoming().keys().hasAll(['id', 'boardId', 'taskId', 'ownerId', 'createdBy', 'title', 'completed', 'position', 'createdAt', 'updatedAt'])
            && incoming().keys().hasOnly(['id', 'boardId', 'taskId', 'ownerId', 'createdBy', 'title', 'completed', 'position', 'createdAt', 'updatedAt'])
            && isValidSubtask(incoming(), boardId, taskId, subtaskId)
            && incoming().createdBy == request.auth.uid
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && boardExists(boardId)
            && incoming().ownerId == getBoard(boardId).data.ownerId
            && exists(/databases/$(database)/documents/boards/$(boardId)/tasks/$(taskId))
            && (isAdmin() || (isBoardActive(boardId) && canCreateTasksOnBoard(boardId)));

          allow update: if isAllowedWorkspaceUser()
            && isValidId(boardId)
            && isValidId(taskId)
            && isValidId(subtaskId)
            && isValidSubtask(incoming(), boardId, taskId, subtaskId)
            && incoming().id == existing().id
            && incoming().boardId == existing().boardId
            && incoming().taskId == existing().taskId
            && incoming().ownerId == existing().ownerId
            && (!('createdBy' in existing()) || incoming().createdBy == existing().createdBy)
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && (isAdmin() || (isBoardActive(boardId) && canEditTasksOnBoard(boardId)))
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['position', 'updatedAt'])
            );

          allow delete: if isAllowedWorkspaceUser()
            && isValidId(boardId)
            && isValidId(taskId)
            && isValidId(subtaskId)
            && (isAdmin() || (isBoardActive(boardId) && canDeleteTasksOnBoard(boardId)));
        }
      }

      // -----------------------------------------------------------------------
      // Task Chat Log Messages Subcollection
      // -----------------------------------------------------------------------
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(boardId) && isValidId(messageId) && canAccessBoard(boardId);
        allow list: if isSignedIn() && (
          isBootstrapAdmin() ||
          resource.data.ownerId == request.auth.uid ||
          canAccessBoard(boardId)
        );

        allow create: if isAllowedWorkspaceUser()
          && isValidId(boardId)
          && isValidId(messageId)
          && incoming().keys().hasAll(['id', 'boardId', 'taskId', 'taskTitle', 'ownerId', 'senderId', 'senderName', 'text', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['id', 'boardId', 'taskId', 'taskTitle', 'ownerId', 'senderId', 'senderName', 'text', 'createdAt', 'updatedAt'])
          && isValidTaskMessage(incoming(), boardId, messageId)
          && incoming().senderId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && boardExists(boardId)
          && incoming().ownerId == getBoard(boardId).data.ownerId
          && exists(/databases/$(database)/documents/boards/$(boardId)/tasks/$(incoming().taskId))
          && (isAdmin() || (isBoardActive(boardId) && canAccessBoard(boardId)));

        allow update: if false;

        allow delete: if isAllowedWorkspaceUser()
          && isValidId(boardId)
          && isValidId(messageId)
          && (isAdmin() || (isBoardActive(boardId) && (isBoardOwner(boardId) || existing().senderId == request.auth.uid)));
      }
    }
  }
}
